{
  "name": "mainsite",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:integrations": "vitest run --project integrations",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "playwright:install": "playwright install --with-deps",
    "release": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release && git push --follow-tags",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --major && git push --follow-tags",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --minor && git push --follow-tags",
    "release:patch": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --patch && git push --follow-tags",
    "cleanup": "nuxt cleanup && rm -rf .nuxt .output dist node_modules/.cache",
    "lint": "oxlint lint .",
    "lint:eslint": "eslint . --ext .ts,.vue",
    "fix": "oxlint fix ."
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/scripts": "1.3.3",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.1",
    "@takumi-rs/core": "^2.5.10",
    "@vueuse/nuxt": "14.4.0",
    "nuxt": "^4.5.2",
    "nuxt-vuefire": "1.1.2",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/test-utils": "4.1.0",
    "@nuxtjs/seo": "^5.3.10",
    "@playwright/test": "^1.62.1",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/sound": "^2.1.3",
    "eslint": "^10.8.0",
    "firebase": "^12.17.1",
    "happy-dom": "^20.11.1",
    "nuxt-authentication": "^2.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pinia-plugin-persistedstate": "^4.7.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.18.0"
}
